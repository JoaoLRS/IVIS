# Copie para .env (ignorado pelo Git) para sobrescrever os padrões de desenvolvimento local.
IVIS_BD_USUARIO=ivis
IVIS_BD_SENHA=ivis_local
IVIS_BD_PORTA=5433
IVIS_CORS_ORIGENS=http://localhost:8080,http://localhost:5173
# A API de limpeza só existe com perfil dev ou homologacao (sem prod).
# Para habilitá-la, defina uma chave aleatória de pelo menos 32 caracteres.
# Escolha dev, homologacao ou prod. Sem perfil, valem apenas as configurações comuns.
SPRING_PROFILES_ACTIVE=dev
IVIS_LIMPEZA_CHAVE=
# Gere uma chave exclusiva com: openssl rand -base64 32
IVIS_JWT_CHAVE_ASSINATURA=
# Use false somente em desenvolvimento local por HTTP; mantenha true em HTTPS/publicação.
IVIS_COOKIE_SEGURO=false
IVIS_LOGIN_TENTATIVAS_MAX=10
IVIS_LOGIN_JANELA=15m
IVIS_RECUPERACAO_TENTATIVAS_MAX=5
IVIS_RECUPERACAO_JANELA=15m
IVIS_RECUPERACAO_VALIDADE=30m
IVIS_URL_REDEFINICAO_SENHA=http://localhost:8080/redefinir-senha
IVIS_EMAIL_REMETENTE=no-reply@ivis.local
# Gerada automaticamente pelos scripts de configuração/execução local.
IVIS_IA_CHAVE_SERVICO=
IVIS_IA_URL=http://localhost:8000
IVIS_IA_TIMEOUT_PERGUNTA=105s
IVIS_IA_TIMEOUT_AVALIACAO=110s
