# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env NÃO é versionado (já está no .gitignore).

# Senha do administrador do Grafana (usuário: admin). Valor de mentira.
GRAFANA_SENHA=trocar-aqui

# IP privado da EC2 app (definido pelo Rafael na AWS).
# Deixe em branco para uso local: o Prometheus então alcança a sua máquina.
IP_APP=
