# Modelo do .env de produção. O arquivo real é gerado na EC2 app a partir do Infisical,
# com chmod 600, e nunca vai para o Git. Aqui não há valores reais.

# Registro do ECR (conta.dkr.ecr.REGIAO.amazonaws.com) e tag da implantação (SHA do commit).
IVIS_ECR_REGISTRO=
IVIS_TAG=

# Domínio público (DuckDNS).
IVIS_DOMINIO=ivis-ia.duckdns.org

# Banco (RDS). Exemplo de URL: jdbc:postgresql://ENDPOINT-DO-RDS:5432/ivis
IVIS_BD_URL=
IVIS_BD_USUARIO=ivis
IVIS_BD_SENHA=

# Segredos da aplicação (Infisical).
IVIS_JWT_CHAVE_ASSINATURA=
IVIS_IA_CHAVE_SERVICO=
NVIDIA_API_KEY=
