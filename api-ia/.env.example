# Copie este arquivo para .env. Nunca coloque credenciais reais no Git.
# No Docker Compose, IVIS_IA_CHAVE_SERVICO vem do .env da raiz.
# Para executar esta API fora do Docker, defina a mesma chave no ambiente local.
# Configure uma chave NVIDIA para gerar perguntas e avaliações.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SEGUNDOS=90
