# Copie este arquivo para .env. Nunca coloque credenciais reais no Git.
IVIS_IA_CHAVE_SERVICO=chave-local-ficticia-substituir-antes-de-usar-123456789
IVIS_IA_USAR_STUB=true
IVIS_IA_STUB_FALHA=nenhuma

# Para usar o modelo NVIDIA, defina IVIS_IA_USAR_STUB=false e informe a chave.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-bolt-e4b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SEGUNDOS=90
